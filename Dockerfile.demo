
FROM python:3.13-slim

WORKDIR /workspace

# Cai cac thu vien Backend cua nhom
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Dua Backend cua Hao va Linh vao container
COPY backend/ ./backend/

# Dua Frontend cua Quynh vao container
COPY frontend/ ./frontend/

ENV PYTHONPATH=/workspace/backend

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "frontend.site_server:app", "--host", "0.0.0.0", "--port", "8000"]
